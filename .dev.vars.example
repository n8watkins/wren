# Copy to .dev.vars for `npm run preview` (wrangler dev on port 3120).
APP_ENV=development
PUBLIC_URL=http://localhost:3120
# Sign-in links stay in the local D1 outbox: `npm run magic-link` prints the latest.
EMAIL_TRANSPORT=outbox
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Only secrets listed under "secrets.required" in wrangler.jsonc load from this
# file, so optional ones (GEMINI_API_KEY, GITHUB_CLIENT_ID/SECRET) are passed
# with --var instead: npm run preview -- --var GEMINI_API_KEY:<key>. Without a
# demo key, chat works with your own key ("Use your own key"). Guest chat uses
# Cloudflare's always-pass Turnstile test keys, set by npm run preview.
# Guest chat locally: Cloudflare's always-pass Turnstile test keys (the real
# site key only works on wren.n8builds.dev).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
